root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
max_line_length = 140
# Compose UI functions use AndroidX's PascalCase convention. Android lint checks
# Compose naming; ktlint keeps its normal naming rule for other functions.
ktlint_function_naming_ignore_when_annotated_with = Composable
