{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cadence:protocol:v1:command",
  "type": "object",
  "required": [
    "version",
    "type",
    "command_id",
    "host_epoch",
    "expires_at_host_ms",
    "expected_revision",
    "action"
  ],
  "properties": {
    "version": { "const": 1 },
    "type": { "const": "command" },
    "command_id": { "$ref": "urn:cadence:protocol:v1:common#/$defs/uuid" },
    "host_epoch": { "$ref": "urn:cadence:protocol:v1:common#/$defs/uuid" },
    "expires_at_host_ms": {
      "$ref": "urn:cadence:protocol:v1:common#/$defs/counter"
    },
    "expected_revision": {
      "$ref": "urn:cadence:protocol:v1:common#/$defs/counter"
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/enqueue" },
        { "$ref": "#/$defs/playNow" },
        { "$ref": "#/$defs/remove" },
        { "$ref": "#/$defs/move" },
        { "$ref": "#/$defs/transport" },
        { "$ref": "#/$defs/seek" },
        { "$ref": "#/$defs/volume" },
        { "$ref": "#/$defs/castTransmit" },
        { "$ref": "#/$defs/videoOutput" },
        { "$ref": "#/$defs/castPresentation" },
        { "$ref": "#/$defs/stageApprove" },
        { "$ref": "#/$defs/lipSyncOffset" },
        { "$ref": "#/$defs/lyricOffset" },
        { "$ref": "#/$defs/shuffle" },
        { "$ref": "#/$defs/repeat" },
        { "$ref": "#/$defs/singEnable" },
        { "$ref": "#/$defs/singDisable" },
        { "$ref": "#/$defs/singMix" },
        { "$ref": "#/$defs/libraryFavorite" },
        { "$ref": "#/$defs/libraryPlaylist" },
        { "$ref": "#/$defs/audioSelectOutput" }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "playNow": {
      "type": "object",
      "required": ["kind", "song", "occurrence_id"],
      "properties": {
        "kind": { "const": "queue.play_now" },
        "song": { "$ref": "urn:cadence:protocol:v1:common#/$defs/song" },
        "occurrence_id": {
          "anyOf": [
            { "$ref": "urn:cadence:protocol:v1:common#/$defs/uuid" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "enqueue": {
      "type": "object",
      "required": ["kind", "song"],
      "properties": {
        "kind": { "enum": ["queue.enqueue", "queue.play_next"] },
        "song": { "$ref": "urn:cadence:protocol:v1:common#/$defs/song" }
      },
      "additionalProperties": false
    },
    "remove": {
      "type": "object",
      "required": ["kind", "entry_id"],
      "properties": {
        "kind": { "const": "queue.remove" },
        "entry_id": { "$ref": "urn:cadence:protocol:v1:common#/$defs/uuid" }
      },
      "additionalProperties": false
    },
    "move": {
      "type": "object",
      "required": ["kind", "entry_id", "before_entry_id"],
      "properties": {
        "kind": { "const": "queue.move" },
        "entry_id": { "$ref": "urn:cadence:protocol:v1:common#/$defs/uuid" },
        "before_entry_id": {
          "anyOf": [
            { "$ref": "urn:cadence:protocol:v1:common#/$defs/uuid" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "required": ["kind", "occurrence_id"],
      "properties": {
        "kind": {
          "enum": [
            "playback.pause",
            "playback.resume",
            "playback.skip",
            "playback.previous",
            "playback.stop"
          ]
        },
        "occurrence_id": {
          "$ref": "urn:cadence:protocol:v1:common#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "seek": {
      "type": "object",
      "required": ["kind", "occurrence_id", "position_ms"],
      "properties": {
        "kind": { "const": "playback.seek" },
        "occurrence_id": {
          "$ref": "urn:cadence:protocol:v1:common#/$defs/uuid"
        },
        "position_ms": {
          "$ref": "urn:cadence:protocol:v1:common#/$defs/counter"
        }
      },
      "additionalProperties": false
    },
    "castTransmit": {
      "type": "object",
      "required": ["kind", "device", "start"],
      "properties": {
        "kind": { "const": "cast.transmit" },
        "device": { "type": "string", "minLength": 1, "maxLength": 200 },
        "start": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "castPresentation": {
      "type": "object",
      "required": ["kind", "presentation"],
      "properties": {
        "kind": { "const": "cast.presentation" },
        "presentation": { "enum": ["auto", "audio_only", "full_suite"] }
      },
      "additionalProperties": false
    },
    "stageApprove": {
      "type": "object",
      "required": ["kind", "pin"],
      "properties": {
        "kind": { "const": "stage.approve" },
        "pin": { "type": "string", "pattern": "^[0-9]{4}$" }
      },
      "additionalProperties": false
    },
    "lyricOffset": {
      "type": "object",
      "required": ["kind", "song", "user_offset_ms"],
      "properties": {
        "kind": { "const": "lyrics.offset" },
        "song": {
          "type": "object",
          "required": ["source", "id"],
          "properties": {
            "source": { "enum": ["catalog", "library"] },
            "id": { "type": "string", "maxLength": 128 }
          },
          "additionalProperties": false
        },
        "user_offset_ms": {
          "type": "integer",
          "minimum": -5000,
          "maximum": 5000
        }
      },
      "additionalProperties": false
    },
    "lipSyncOffset": {
      "type": "object",
      "required": ["kind", "lip_sync_offset_ms"],
      "properties": {
        "kind": { "const": "lip_sync.offset" },
        "lip_sync_offset_ms": {
          "type": "integer",
          "minimum": -500,
          "maximum": 500
        }
      },
      "additionalProperties": false
    },
    "videoOutput": {
      "type": "object",
      "required": ["kind", "video_output"],
      "properties": {
        "kind": { "const": "video.output" },
        "video_output": { "enum": ["host_display", "cast_transmitter"] }
      },
      "additionalProperties": false
    },
    "volume": {
      "type": "object",
      "required": ["kind", "percent"],
      "properties": {
        "kind": { "const": "playback.volume" },
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "shuffle": {
      "type": "object",
      "required": ["kind", "enabled"],
      "properties": {
        "kind": { "const": "playback.shuffle" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "repeat": {
      "type": "object",
      "required": ["kind", "mode"],
      "properties": {
        "kind": { "const": "playback.repeat" },
        "mode": { "enum": ["off", "one", "all"] }
      },
      "additionalProperties": false
    },
    "libraryIdentity": {
      "type": "object",
      "required": ["source", "id"],
      "properties": {
        "source": { "const": "library" },
        "id": { "type": "string", "pattern": "^[0-9A-F]{16}$" }
      },
      "additionalProperties": false
    },
    "libraryFavorite": {
      "type": "object",
      "required": ["kind", "song", "enabled"],
      "properties": {
        "kind": { "const": "library.favorite" },
        "song": { "$ref": "#/$defs/libraryIdentity" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "libraryPlaylist": {
      "type": "object",
      "required": ["kind", "name", "songs"],
      "properties": {
        "kind": { "const": "library.addToPlaylist" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "songs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/libraryIdentity" }
        }
      },
      "additionalProperties": false
    },
    "audioSelectOutput": {
      "type": "object",
      "required": ["kind", "output"],
      "properties": {
        "kind": { "const": "audio.selectOutput" },
        "output": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "singEnable": {
      "type": "object",
      "required": ["kind", "occurrence_id"],
      "properties": {
        "kind": { "const": "sing.enable" },
        "occurrence_id": {
          "$ref": "urn:cadence:protocol:v1:common#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "singDisable": {
      "type": "object",
      "required": ["kind", "occurrence_id"],
      "properties": {
        "kind": { "const": "sing.disable" },
        "occurrence_id": {
          "$ref": "urn:cadence:protocol:v1:common#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "singMix": {
      "type": "object",
      "required": ["kind", "occurrence_id", "vocal_percent"],
      "properties": {
        "kind": { "const": "sing.mix" },
        "occurrence_id": {
          "$ref": "urn:cadence:protocol:v1:common#/$defs/uuid"
        },
        "vocal_percent": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    }
  }
}
