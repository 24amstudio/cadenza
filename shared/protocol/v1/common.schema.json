{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cadence:protocol:v1:common",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "counter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "song": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source", "id"],
          "properties": {
            "source": { "const": "catalog" },
            "id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["source", "id"],
          "properties": {
            "source": { "const": "library" },
            "id": { "type": "string", "pattern": "^[0-9A-F]{16}$" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
